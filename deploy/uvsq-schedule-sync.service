[Unit]
Description=Regenere le calendrier iCal UVSQ (uvsq-schedule-sync)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=uvsq-schedule-sync
WorkingDirectory=/opt/uvsq-schedule-sync
# Fichier local (non versionné) contenant UVSQ_OUT_PATH avec le chemin réel,
# token secret inclus. Voir deploy/env.example. Le "-" rend le fichier optionnel
# pour que l'unité ne plante pas s'il est absent (les valeurs par défaut de
# config.js s'appliquent alors, sans écrire de fichier).
EnvironmentFile=-/etc/uvsq-schedule-sync/env
ExecStart=/usr/bin/node src/index.js

# Durcissement : le service n'a besoin que de LIRE son code (WorkingDirectory),
# jamais d'y écrire - seul le répertoire servi par Caddy doit être accessible
# en écriture. ProtectSystem=strict rend tout le reste read-only, ce qui
# n'empêche pas la lecture du code, donc WorkingDirectory n'a pas besoin
# d'être dans ReadWritePaths ni d'appartenir à cet utilisateur.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/edt.upsclay.thuguet.fr
PrivateTmp=true
