# Exemple à adapter et fusionner dans votre Caddyfile existant (ou fichier
# séparé importé depuis celui-ci). Sert le calendrier sous un chemin secret
# (le token généré dans deploy/env.example), sans authentification : aucun
# risque de blocage côté Apple Calendar/Google Agenda sur webcal://, et le
# token joue le rôle de secret puisque Caddy ne liste pas les répertoires
# (pas de directive "browse" ci-dessous).

edt.upsclay.thuguet.fr {
	root * /var/www/edt.upsclay.thuguet.fr
	file_server

	# Le calendrier est déjà protégé par un chemin secret (token) : on évite
	# en plus qu'un moteur de recherche l'indexe ou le mette en cache.
	header X-Robots-Tag "noindex, nofollow, noarchive"

	@ics path *.ics
	header @ics Content-Type "text/calendar; charset=utf-8"
	header @ics Cache-Control "public, max-age=300"

	log {
		output file /var/log/caddy/edt.upsclay.thuguet.fr.access.log
		format console
	}
}
