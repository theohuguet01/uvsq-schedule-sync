# Exemple à adapter et fusionner dans votre Caddyfile existant (ou fichier
# séparé importé depuis celui-ci). Sert le calendrier sous un chemin secret
# (le token généré dans deploy/env.example), sans authentification : aucun
# risque de blocage côté Apple Calendar/Google Agenda sur webcal://, et le
# token joue le rôle de secret puisque Caddy ne liste pas les répertoires
# (pas de directive "browse" ci-dessous).

edt.upsaclay.thuguet.fr {
	root * /var/www/edt.upsaclay.thuguet.fr
	file_server

	# Le calendrier est déjà protégé par un chemin secret (token) : on évite
	# en plus qu'un moteur de recherche l'indexe ou le mette en cache.
	header X-Robots-Tag "noindex, nofollow, noarchive"

	@ics path *.ics
	header @ics Content-Type "text/calendar; charset=utf-8"
	header @ics Cache-Control "public, max-age=300"

	# Auto-inscription et suppression (public/inscription.html et
	# confidentialite.html, servis en statique par le file_server ci-dessus) :
	# les formulaires appellent /api/register et /api/unregister en relatif,
	# donc même origine que la page - proxifiés vers uvsq-schedule-register.service
	# qui n'écoute qu'en local (127.0.0.1), jamais exposé directement.
	reverse_proxy /api/register 127.0.0.1:8787
	reverse_proxy /api/unregister 127.0.0.1:8787

	# Page 404 personnalisée (public/404.html) plutôt que la page d'erreur par
	# défaut de Caddy : ne révèle rien de plus qu'un 404 générique (un token
	# inconnu doit rester indiscernable d'une page qui n'existe pas), tout en
	# restant cohérente avec le reste du site.
	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/edt.upsaclay.thuguet.fr.access.log
		format console
	}
}
