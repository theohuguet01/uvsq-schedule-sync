# Copier ce fichier vers /etc/uvsq-schedule-sync/env sur le serveur (PAS dans
# ce dépôt) et remplacer <token> par une valeur générée avec :
#   openssl rand -hex 16
#
# Le token dans le chemin fait office de "secret" : personne ne peut deviner
# ni lister l'URL du calendrier (Caddy ne liste pas les répertoires sans le
# directive "browse", qu'on n'active pas ici).

UVSQ_OUT_PATH=/var/www/edt.upsclay.thuguet.fr/<token>/edt.ics

# --- Mode multi-étudiants (alternative à UVSQ_OUT_PATH ci-dessus) ---
#
# Pour publier un calendrier par étudiant (chacun avec sa propre formation et
# son propre token), utiliser UVSQ_STUDENTS_PATH + UVSQ_OUT_DIR à la place de
# UVSQ_OUT_PATH. Voir deploy/students.json.example pour le format du registre
# (à copier vers /etc/uvsq-schedule-sync/students.json, hors dépôt git puisqu'il
# contient les tokens). Chaque étudiant obtient alors :
#   https://edt.upsclay.thuguet.fr/<son-token>/edt.ics
#
# UVSQ_STUDENTS_PATH=/etc/uvsq-schedule-sync/students.json
# UVSQ_OUT_DIR=/var/www/edt.upsclay.thuguet.fr

# --- Serveur d'auto-inscription (uvsq-schedule-register.service) ---
#
# Permet aux étudiants de générer eux-mêmes leur entrée dans le registre
# ci-dessus (via public/uvsq/inscription.html) et de la supprimer eux-mêmes
# (via public/uvsq/confidentialite.html, droit à l'effacement), sans
# intervention manuelle. Ce service partage ce même fichier d'environnement :
# UVSQ_STUDENTS_PATH et UVSQ_OUT_DIR ci-dessus sont réutilisés tels quels
# (obligatoires pour ce service aussi). Seul UVSQ_PUBLIC_BASE_URL est à
# ajouter :
#
# UVSQ_PUBLIC_BASE_URL=https://edt.upsclay.thuguet.fr
#
# Le service n'écoute qu'en local (127.0.0.1) : c'est Caddy qui l'expose via
# un reverse_proxy sur /api/register et /api/unregister (voir
# deploy/Caddyfile.example) - il ne doit jamais être exposé directement sur
# une interface publique.
#
# UVSQ_REGISTER_PORT=8787
# UVSQ_REGISTER_HOST=127.0.0.1
#
# Anti-abus (fenêtre glissante en mémoire, par IP) :
# UVSQ_REGISTER_RATE_MAX=5
# UVSQ_REGISTER_RATE_WINDOW_MS=600000
