# Copier ce fichier vers /etc/uvsq-schedule-sync/env sur le serveur (PAS dans
# ce dépôt) et remplacer <token> par une valeur générée avec :
#   openssl rand -hex 16
#
# Le token dans le chemin fait office de "secret" : personne ne peut deviner
# ni lister l'URL du calendrier (Caddy ne liste pas les répertoires sans le
# directive "browse", qu'on n'active pas ici).

UVSQ_OUT_PATH=/var/www/edt.upsclay.thuguet.fr/<token>/edt.ics

# --- Mode multi-étudiants (alternative à UVSQ_OUT_PATH ci-dessus) ---
#
# Pour publier un calendrier par étudiant (chacun avec sa propre formation et
# son propre token), utiliser UVSQ_STUDENTS_PATH + UVSQ_OUT_DIR à la place de
# UVSQ_OUT_PATH. Voir deploy/students.json.example pour le format du registre
# (à copier vers /etc/uvsq-schedule-sync/students.json, hors dépôt git puisqu'il
# contient les tokens). Chaque étudiant obtient alors :
#   https://edt.upsclay.thuguet.fr/<son-token>/edt.ics
#
# UVSQ_STUDENTS_PATH=/etc/uvsq-schedule-sync/students.json
# UVSQ_OUT_DIR=/var/www/edt.upsclay.thuguet.fr
